# ArXplore 환경 변수 예시
#
#   cp .env.example .env
#
# [필수]  로컬 실행(compose.yaml)에 반드시 필요한 값
# [서버]  서버 스택(compose.server.yaml) 또는 parser 프로필의 worker에서만 필요한 값
# [선택]  코드나 compose에 기본값이 있는 값. 주석 처리된 값이 기본값이다
#
# `change-me`로 시작하는 값은 실제 값으로 바꿔야 한다. scripts/setup-server.sh는
# POSTGRES_PASSWORD가 `change-me`로 시작하면 실행을 거부한다.
#
# 설정은 src/arxplore/config.py가 읽는다. 빈 값(`KEY=`)은 설정하지 않은 것으로 보고 기본값을 쓴다.
# 옛 이름(DJANGO_*, OPENAI_API_BASE)도 별칭으로 받는다. 새 이름과 옛 이름이 둘 다 있으면 새 이름이 이긴다.
# 호스트에서 arxplore 명령을 돌릴 때 다른 파일을 읽히려면 셸에서 ARXPLORE_ENV_FILE=경로를 준다(.env 안에 적으면 효과가 없다).
#
# 접속 주소 규칙 (config.py resolve_host_and_port)
#   POSTGRES_HOST / PROD_POSTGRES_HOST는 `host` 또는 `host:port` 형식이다.
#   포트를 적지 않으면 SERVER_POSTGRES_PORT를 쓴다.
#   SERVER_POSTGRES_PORT는 "서버가 호스트에 공개하는 포트"이므로, 같은 compose 네트워크 안에서
#   서비스 이름으로 접속할 때는 `postgres-local:5432`처럼 컨테이너 내부 포트를 직접 적는다.
#
# 제거된 변수: DJANGO_SECRET_KEY(CSRF 토큰에 서명 키가 필요 없다), APP_RUNTIME_MODE(RUNTIME으로 대체),
#   AIRFLOW_*, SERVER_AIRFLOW_PORT, AIRFLOW_BASE_URL(Airflow 제거), SLEEP_SECONDS(worker 인자 제거)

# ─── PostgreSQL ─────────────────────────────────────────────────────────
# [필수] api / worker 컨테이너가 접속할 주소. compose가 이 값을 컨테이너의 POSTGRES_HOST로 넣는다
#   로컬 단독(local-db 프로필): postgres-local:5432  (같은 compose 네트워크, 내부 포트)
#   원격 서버:                  <TAILSCALE_SERVER_IP>  (포트 생략 시 SERVER_POSTGRES_PORT 사용)
PROD_POSTGRES_HOST=postgres-local:5432
# [필수] 호스트에서 직접 실행하는 arxplore 명령(uv run arxplore migrate 등)이 쓰는 주소
#   로컬 단독 또는 SSH 포워딩: localhost  (포트는 SERVER_POSTGRES_PORT)
#   서버 compose의 scheduler는 이 값 대신 postgres:5432를 쓴다
POSTGRES_HOST=localhost
# [필수] 서버/로컬 PostgreSQL이 호스트에 공개하는 포트. compose 기본값은 15432,
#        config.py 기본값은 5432이므로 명시해 두는 편이 안전하다
SERVER_POSTGRES_PORT=15432
# [필수] PostgreSQL 컨테이너가 데이터 볼륨을 처음 초기화할 때 만드는 DB. APP_POSTGRES_DB가 비어 있으면 앱도 이 DB를 쓴다.
#        기존 서버는 원래 값(예: arxplore_meta)을 그대로 둔다
POSTGRES_DB=arxplore
# [필수] 애플리케이션 테이블(papers, paper_chunks, prepare_jobs, scheduler_runs, AI 결과 캐시 등)이 들어가는 DB.
#        docker/postgres/init/01-create-app-db.sh가 최초 기동 시 만든다
APP_POSTGRES_DB=arxplore_app
POSTGRES_USER=arxplore
POSTGRES_PASSWORD=change-me-postgres-password
# [선택] 프로세스(api 워커, worker, scheduler)당 연결 풀 최대 크기. 서버 max_connections는 프로세스 수 x 이 값 이상이어야 한다
# POSTGRES_POOL_MAX=8
# [선택] 풀이 가득 찼을 때 연결을 기다리는 시간(초)
# POSTGRES_POOL_TIMEOUT=30
# [선택] 새 연결을 맺을 때 기다리는 시간(초). 0이면 제한 없이 기다린다
# POSTGRES_CONNECT_TIMEOUT=10

# ─── LLM (OpenAI) ───────────────────────────────────────────────────────
# [필수] 웹의 AI 기능(개요·상세 요약 생성, 챗, 에이전트, 질의 임베딩)과 worker 임베딩 생성에 쓴다.
#        비어 있으면 캐시된 개요·상세 요약만 보이고, 새 생성·챗·에이전트 요청은 503을 돌려준다.
#        질의 임베딩도 못 만들어 검색은 lexical로 동작한다
OPENAI_API_KEY=change-me-openai-api-key
# [선택] OpenAI 호환 API 주소. 비우면 OpenAI 기본 주소. 테스트용 가짜 서버(tests/fakes/openai_server.py)를 붙일 때 쓴다
#        옛 이름: OPENAI_API_BASE
# OPENAI_BASE_URL=http://127.0.0.1:8900/v1
# [선택] 챗·에이전트 기본 모델. 개요는 gpt-5-mini, 상세 요약은 요청마다 gpt-5-mini / gpt-5 중 선택
# OPENAI_MODEL=gpt-4o
# [선택] paper_embeddings 컬럼이 VECTOR(1536)이므로 차원을 바꾸면 스키마도 바꿔야 한다.
#        api·worker·scheduler는 시작할 때 컬럼 차원과 이 값이 다르면 종료한다
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# OPENAI_EMBEDDING_DIMENSIONS=1536
# EMBEDDING_BATCH_SIZE=64

# ─── 검색 · 에이전트 ─────────────────────────────────────────────────────
# [선택] hybrid: 질의 임베딩 키가 있으면 lexical과 vector 점수를 질의별로 정규화해 가중 합으로 합치고,
#        키가 없거나 임베딩 호출이 실패하면 lexical로 내려간다. lexical: 전문 검색만 쓴다.
#        에이전트 도구와 상세 챗이 같은 설정을 따른다
# RETRIEVAL_MODE=hybrid
# [선택] vector 결과로 인정할 최소 코사인 유사도(0~1). 0이면 거르지 않는다
# VECTOR_MIN_SIMILARITY=0
# [선택] 에이전트의 최대 단계 수(최소 4). 넘으면 그때까지의 답에 단계 제한 안내를 붙여 끝낸다
# AGENT_RECURSION_LIMIT=12
# [선택] 에이전트 답변 스트리밍 버퍼(글자). 도구 호출 앞의 짧은 서두가 답변에 섞이지 않도록 이 길이까지 보류한 뒤 실시간 전송
# AGENT_STREAM_BUFFER_CHARS=120

# ─── 웹 (api) ───────────────────────────────────────────────────────────
# [선택] `true`일 때만 켜진다. 켜면 /docs가 열리고 ALLOWED_HOSTS 기본값이 *가 된다. compose의 api는 false로 고정한다
#        옛 이름: DJANGO_DEBUG
# DEBUG=false
# [선택] 허용할 Host 헤더(쉼표 구분, `.example.com`은 하위 도메인 포함). 목록 밖 Host는 400을 받는다
#        옛 이름: DJANGO_ALLOWED_HOSTS
# ALLOWED_HOSTS=localhost,127.0.0.1
# [선택] POST(개요·요약·챗)의 Origin 헤더로 허용할 origin(scheme://host[:port], 쉼표 구분). 같은 origin 요청은 목록과 관계없이 통과한다.
#        기본값은 http://localhost, http://127.0.0.1과 두 호스트의 FRONTEND_PORT origin이다. 다른 origin에서 여는 화면이 있으면 적는다
#        옛 이름: DJANGO_CSRF_TRUSTED_ORIGINS
# CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173
# [선택] HTTPS 뒤에서만 true로 둔다. CSRF 쿠키에 Secure를 붙이고, Origin 검사에서 X-Forwarded-Proto를 믿는다
#        옛 이름: DJANGO_SECURE_COOKIES
# SECURE_COOKIES=false
# [선택] true면 api가 frontend/dist(실행 위치 기준)를 /에서 SPA로 서빙한다. 도커 없이 띄우거나 Playwright로 볼 때 쓴다.
#        compose에서는 web(nginx)이 서빙하므로 켜지 않는다
# SERVE_FRONTEND_DIST=false
# [선택] LangSmith 추적 라벨(runtime:)로만 쓴다. dev, production, local, test 중 하나(development는 dev로 본다).
#        compose의 api·worker·scheduler는 production으로 고정한다. 옛 이름 APP_RUNTIME_MODE는 받지 않는다
# RUNTIME=development
# [선택] api 컨테이너의 uvicorn 워커 수(compose 전용). 2 이상이면 rate limit 카운터가 워커마다 따로 세지므로 REDIS_URL을 함께 둔다
# API_WORKERS=1

# ─── rate limit ─────────────────────────────────────────────────────────
# 계정 없이 모든 기능이 열려 있고, 요청 수는 클라이언트 IP 단위로 제한한다
# [선택] 카운터를 공유할 Redis(예: redis://redis:6379/0). 비우면 프로세스 메모리에 센다. compose에는 Redis 서비스가 없다
# REDIS_URL=
# RATE_LIMIT_ENABLED=true
# [선택] LLM을 부르는 요청(개요·상세 요약·상세 챗·어시스턴트, 스트림 포함 6개 경로) 수 제한. IP당 분당, 한도를 공유한다
# RATE_LIMIT_LLM_PER_MINUTE=30
# [선택] detail.json 조회 IP당 분당 한도
# RATE_LIMIT_DETAIL_PER_MINUTE=60
# [선택] 클라이언트 IP를 읽을 헤더(첫 값). docker/web/nginx.conf와 Vite 개발 서버가 X-Real-IP를 넣는다.
#        `none`이면 헤더를 쓰지 않고 소켓 주소를 쓴다. 프록시 없이 api를 직접 공개할 때는 헤더 위조를 막으려고 none으로 둔다.
#        빈 값은 설정하지 않은 것으로 보므로 옛 "비우면 헤더 끔"은 none으로 바꾼다
# RATE_LIMIT_IP_HEADER=X-Real-IP

# ─── LangSmith ──────────────────────────────────────────────────────────
# [선택] 키가 없으면 추적과 LangSmith 정리 작업(scheduler langsmith_cleanup)을 건너뛴다
# LANGSMITH_API_KEY=change-me-langsmith-api-key
# LANGSMITH_PROJECT=ArXplore
# LANGSMITH_WORKSPACE_ID=
# LANGSMITH_TRACING=true
# [선택] 추적 태그 user:에 붙는 이름. 비우면 프로세스의 OS 사용자(컨테이너에서는 app)
# LANGSMITH_TRACE_USER=your-name

# ─── 서버 스택 (compose.server.yaml: postgres + scheduler) ────────────────
# [서버] 서버 compose가 PostgreSQL 포트를 이 IP에만 바인딩한다.
#        scripts/setup.sh forward도 이 값을 쓴다. 저장소에 실제 IP를 커밋하지 않는다
# TAILSCALE_SERVER_IP=100.64.0.10
# [선택] 수집 날짜 계산과 cron(collect 18:00, maintenance 3시간마다, langsmith_cleanup 03:00) 해석에 쓰는 시간대. IANA 이름
# SCHEDULER_TIMEZONE=Asia/Seoul

# ─── 수집 소스 ───────────────────────────────────────────────────────────
# [선택] HF Daily Papers는 이 주소의 origin + /api/daily_papers(JSON API)로 받는다
# HF_DAILY_PAPERS_BASE_URL=https://huggingface.co/papers
# HF_REQUEST_TIMEOUT_SECONDS=20
# ARXIV_API_BASE_URL=https://export.arxiv.org/api/query
# ARXIV_REQUEST_TIMEOUT_SECONDS=45
# ARXIV_REQUEST_BATCH_SIZE=25
# ARXIV_REQUEST_DELAY_SECONDS=3.0

# ─── PDF 파서 (HURIDOCS, parser 프로필) ──────────────────────────────────
# [서버] 코드에는 기본값도 자동 감지도 없다. 비어 있으면 layout 단계를 건너뛰고 pypdf로 내려간다.
#        compose.yaml의 worker는 값이 비어 있으면 http://layout-parser:5060을 넣는다.
#        compose 밖에서 worker를 돌리면 직접 적는다
# LAYOUT_PARSER_BASE_URL=http://layout-parser:5060
# LAYOUT_PARSER_TIMEOUT_SECONDS=600
# LAYOUT_PARSER_FAST=false
# LAYOUT_PARSER_PARSE_TABLES_AND_MATH=true

# ─── worker (parser 프로필) ──────────────────────────────────────────────
# [선택] worker가 claim할 때, 마지막 heartbeat(없으면 claim 시각)가 이 시간보다 오래된 processing 잡을 되돌린다
# PREPARE_JOB_STALE_SECONDS=900
# [선택] 이 횟수를 넘긴 잡은 failed로 닫힌다
# PREPARE_JOB_MAX_ATTEMPTS=3
# [선택] true면 worker가 백필 수집분(mode=backfill 잡)도 처리하고 임베딩까지 한다. false면 최신 수집분만 처리한다
# PREPARE_BACKFILL_ENABLED=false
# [선택] compose.yaml worker 명령행 인자(compose 전용): claim할 잡 수, 논문당·백로그 임베딩 청크 수, 대기 알림을 기다리는 최대 시간(초)
# MAX_JOBS_PER_RUN=1
# EMBED_MAX_CHUNKS=200
# EMBED_BACKLOG_MAX_CHUNKS=400
# WAIT_TIMEOUT_SECONDS=120

# ─── 호스트 포트 · compose ────────────────────────────────────────────────
# [선택] web(nginx), Vite 개발 서버(dev 프로필), HURIDOCS(parser 프로필)가 호스트에 공개하는 포트.
#        FRONTEND_PORT는 CSRF_TRUSTED_ORIGINS 기본값에도 들어간다
# PROD_HTTP_PORT=80
# FRONTEND_PORT=5173
# LAYOUT_PARSER_PORT=5060
# [선택] docker compose가 직접 읽는다. local-db로만 쓸 때 local-db를 두면 scripts/setup.sh와 docker compose 명령에 --profile을 붙이지 않아도 된다
# COMPOSE_PROFILES=local-db
