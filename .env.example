# ArXplore 환경 변수 예시
#
#   cp .env.example .env
#
# [필수]  로컬 단독 실행(`docker compose --profile local-db`)에 반드시 필요한 값
# [서버]  원격 서버 스택(docker-compose.server.yml) 또는 수집/prepare worker에서만 필요한 값
# [선택]  코드 기본값이 있는 값. 주석 처리된 값이 기본값이다
#
# `change-me`로 시작하는 값은 실제 비밀값으로 바꿔야 한다. scripts/setup.sh는
# DJANGO_SECRET_KEY가 비어 있거나 `change-me`로 시작하면 실행을 거부한다.
#
# 접속 주소 규칙 (src/shared/settings.py resolve_host_and_port)
#   POSTGRES_HOST / PROD_POSTGRES_HOST / MONGO_HOST는 `host` 또는 `host:port` 형식이다.
#   포트를 적지 않으면 SERVER_POSTGRES_PORT / SERVER_MONGO_PORT를 쓴다.
#   SERVER_*_PORT는 "서버가 호스트에 공개하는 포트"이므로, 같은 compose 네트워크 안에서
#   컨테이너 이름으로 접속할 때는 `postgres-local:5432`, `arxplore-postgres:5432`처럼
#   컨테이너 내부 포트를 직접 적는다.

# ─── Django ─────────────────────────────────────────────────────────────
# [필수] 비어 있으면 Django가 시작하지 않는다(DJANGO_DEBUG=true일 때만 개발용 키로 대체). python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-django-secret-key
# [선택] 비어 있으면 꺼진다. 값이 `true`일 때만 켜진다. 로컬 compose는 False로 강제하므로 호스트에서 manage.py를 직접 돌릴 때만 의미가 있다
# DJANGO_DEBUG=true
# [선택] compose 기본값: localhost,127.0.0.1
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# [선택] compose 기본값: http://localhost,http://127.0.0.1 (PROD_HTTP_PORT를 바꾸면 포트를 포함해 추가)
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
# [선택] compose가 production으로 덮어쓴다
# APP_RUNTIME_MODE=development
# [선택] HTTPS 뒤에서만 true로 둔다. 세션·CSRF 쿠키에 Secure 속성을 붙인다
# DJANGO_SECURE_COOKIES=false
# [선택] Django admin을 URL에 연결할지 여부. nginx는 admin 경로를 프록시하지 않는다
# DJANGO_ADMIN_ENABLED=false
# DJANGO_ADMIN_PATH=admin/

# ─── 데모 모드 · 세션 키 · rate limit ────────────────────────────────────
# [선택] true면 로그인 없이 목록·상세와 캐시된 개요·상세 요약을 볼 수 있다. 새 생성과 챗은 로그인 + 개인 키가 필요하다
# DEMO_MODE=true
# [선택] 세션에 저장하는 개인 OpenAI 키를 암호화하는 Fernet 키. 비우면 DJANGO_SECRET_KEY에서 유도한다.
#        값을 바꾸면 이미 저장된 세션 키는 복호화되지 않아 다시 등록해야 한다
# SESSION_KEY_ENCRYPTION_KEY=
# [선택] rate limit 카운터를 공유할 Redis(예: redis://redis:6379/0). 비우면 프로세스별 LocMem 캐시라서
#        gunicorn 워커 4개가 각자 센다(실제 허용량이 4배). compose에는 Redis 서비스가 없다
# REDIS_URL=
# RATE_LIMIT_ENABLED=true
# [선택] 로그인·회원가입 요청 수 제한 (IP당 분당)
# RATE_LIMIT_AUTH_PER_MINUTE=10
# [선택] LLM을 부르는 요청(개요·상세 요약·챗·에이전트) 수 제한 (로그인 사용자당, 비로그인은 IP당 분당)
# RATE_LIMIT_LLM_PER_MINUTE=30
# [선택] 클라이언트 IP를 읽을 헤더. docker/nginx/nginx.conf가 X-Real-IP를 넣는다
# RATE_LIMIT_IP_HEADER=X-Real-IP

# ─── PostgreSQL ─────────────────────────────────────────────────────────
# [필수] django / prepare-worker 컨테이너가 접속할 주소. compose가 이 값을 컨테이너의 POSTGRES_HOST로 넣는다
#   로컬 단독(local-db 프로필): postgres-local:5432  (같은 compose 네트워크, 내부 포트)
#   원격 서버:                  <TAILSCALE_SERVER_IP>  (포트 생략 시 SERVER_POSTGRES_PORT 사용)
PROD_POSTGRES_HOST=postgres-local:5432
# [필수] 호스트에서 직접 실행하는 스크립트(scripts/migrate_schema.py 등)와 Airflow가 쓰는 주소
#   로컬 단독 또는 SSH 포워딩: localhost      (포트는 SERVER_POSTGRES_PORT)
#   서버 compose 안의 Airflow:  arxplore-postgres:5432
POSTGRES_HOST=localhost
# [필수] 서버/로컬 PostgreSQL이 호스트에 공개하는 포트. compose 기본값은 15432,
#        settings.py 기본값은 5432이므로 명시해 두는 편이 안전하다
SERVER_POSTGRES_PORT=15432
# [필수] Airflow 메타데이터 DB이자 컨테이너 초기 DB
POSTGRES_DB=arxplore_meta
# [필수] 애플리케이션 테이블(papers, paper_chunks, prepare_jobs, Django 테이블)이 들어가는 DB.
#        docker/postgres/init/01-create-app-db.sh가 최초 기동 시 생성한다
APP_POSTGRES_DB=arxplore_app
POSTGRES_USER=arxplore
POSTGRES_PASSWORD=change-me-postgres-password
# [선택] 프로세스(gunicorn 워커)당 PostgreSQL 연결 풀 최대 크기. 서버 max_connections는 워커 수 x 이 값 이상이어야 한다
# POSTGRES_POOL_MAX=8
# [선택] 풀이 가득 찼을 때 연결을 기다리는 시간(초)
# POSTGRES_POOL_TIMEOUT=30

# ─── LLM (OpenAI) ───────────────────────────────────────────────────────
# [서버] prepare-worker의 임베딩 생성(API 호출)에 쓴다.
#        웹의 AI 기능(개요·상세 요약·챗·에이전트)은 사용자가 설정 화면에 등록한 개인 키를 쓴다
OPENAI_API_KEY=change-me-openai-api-key
# [선택] 챗·에이전트 기본 모델. 개요는 gpt-5-mini, 상세 요약은 사용자가 gpt-5-mini / gpt-5 중 선택
# OPENAI_MODEL=gpt-4o
# [선택] 임베딩은 API로 생성한다. paper_embeddings 컬럼이 VECTOR(1536)이므로 차원을 바꾸면 스키마도 바꿔야 한다
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# OPENAI_EMBEDDING_DIMENSIONS=1536
# EMBEDDING_BATCH_SIZE=64

# ─── 검색 · 에이전트 ─────────────────────────────────────────────────────
# [선택] hybrid: 질의 임베딩을 만들 수 있으면(사용자 개인 키) lexical + vector를 RRF로 합치고, 못 만들면 lexical로 내려간다.
#        lexical: 전문 검색만 쓴다. 에이전트 도구와 상세 챗이 같은 설정을 따른다
# RETRIEVAL_MODE=hybrid
# [선택] vector 결과로 인정할 최소 코사인 유사도. 0이면 거르지 않는다
# VECTOR_MIN_SIMILARITY=0
# [선택] LangGraph 에이전트의 최대 단계 수(최소 4). 넘으면 그때까지의 답에 단계 제한 안내를 붙여 끝낸다
# AGENT_RECURSION_LIMIT=12

# ─── LangSmith ──────────────────────────────────────────────────────────
# [선택] 키가 없으면 트레이싱은 꺼진다
# LANGSMITH_API_KEY=change-me-langsmith-api-key
# LANGSMITH_PROJECT=ArXplore
# LANGSMITH_WORKSPACE_ID=
# LANGSMITH_TRACING=true
# LANGSMITH_TRACE_USER=your-name

# ─── MongoDB (raw 저장소) ────────────────────────────────────────────────
# [서버] 수집 DAG와 prepare-worker가 raw payload를 읽고 쓴다. 웹 서비스만 띄울 때는 필요 없다
#   원격 서버에 붙는 로컬 worker: <TAILSCALE_SERVER_IP>  (포트는 SERVER_MONGO_PORT)
#   서버 compose 안의 Airflow:    arxplore-mongo:27017
# MONGO_HOST=arxplore-mongo:27017
# SERVER_MONGO_PORT=17017
# MONGO_DB=arxplore_source
# MONGO_INITDB_ROOT_USERNAME=arxplore
# MONGO_INITDB_ROOT_PASSWORD=change-me-mongo-password
# MONGO_DAILY_PAPERS_COLLECTION=daily_papers_raw
# MONGO_PIPELINE_STATE_COLLECTION=pipeline_state

# ─── Airflow (서버 스택) ─────────────────────────────────────────────────
# [서버] docker-compose.server.yml과 scripts/setup-server.sh가 비어 있으면 실행을 거부한다
# AIRFLOW_ADMIN_USER=admin
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AIRFLOW_FERNET_KEY=change-me-fernet-key
# AIRFLOW_API_SECRET_KEY=change-me-airflow-api-secret
# AIRFLOW_API_AUTH_JWT_SECRET=change-me-airflow-jwt-secret
# AIRFLOW_UID=50000
# SERVER_AIRFLOW_PORT=18080
# [선택] django 컨테이너에 전달만 되고 현재 코드에서 읽는 곳은 없다
# AIRFLOW_BASE_URL=

# ─── Tailscale ──────────────────────────────────────────────────────────
# [서버] 서버 compose가 PostgreSQL/MongoDB/Airflow 포트를 이 IP에만 바인딩한다.
#        scripts/setup.sh forward도 이 값을 쓴다. 저장소에 실제 IP를 커밋하지 않는다
# TAILSCALE_SERVER_IP=100.64.0.10

# ─── 수집 소스 ───────────────────────────────────────────────────────────
# [선택]
# HF_DAILY_PAPERS_BASE_URL=https://huggingface.co/papers
# HF_REQUEST_TIMEOUT_SECONDS=20
# ARXIV_API_BASE_URL=https://export.arxiv.org/api/query
# ARXIV_REQUEST_TIMEOUT_SECONDS=45
# ARXIV_REQUEST_BATCH_SIZE=25
# ARXIV_REQUEST_DELAY_SECONDS=3.0

# ─── PDF 파서 (HURIDOCS, parser 프로필) ──────────────────────────────────
# [서버] 코드에는 기본값도 자동 감지도 없다. 비어 있으면 layout 단계를 건너뛰고 pypdf로 내려간다.
#        docker-compose.yml의 prepare-worker는 값이 비어 있으면 http://layout-parser:5060을 넣는다.
#        compose 밖에서 worker를 돌리면 직접 적는다
# LAYOUT_PARSER_BASE_URL=http://layout-parser:5060
# LAYOUT_PARSER_TIMEOUT_SECONDS=600
# LAYOUT_PARSER_FAST=false
# LAYOUT_PARSER_PARSE_TABLES_AND_MATH=true

# ─── 호스트 포트 ─────────────────────────────────────────────────────────
# [선택]
# PROD_HTTP_PORT=80
# FRONTEND_PORT=5173
# LAYOUT_PARSER_PORT=5060

# ─── prepare-worker 튜닝 ─────────────────────────────────────────────────
# [선택] worker가 claim할 때, 마지막 heartbeat(없으면 claim 시각)가 이 시간보다 오래된 processing 잡을 되돌린다
# PREPARE_JOB_STALE_SECONDS=900
# [선택] 이 횟수를 넘긴 잡은 failed로 닫힌다
# PREPARE_JOB_MAX_ATTEMPTS=3
# [선택] docker-compose.yml prepare-worker 명령행 인자
# MAX_JOBS_PER_RUN=1
# EMBED_MAX_CHUNKS=200
# EMBED_BACKLOG_MAX_CHUNKS=400
# SLEEP_SECONDS=120
# WAIT_TIMEOUT_SECONDS=120
